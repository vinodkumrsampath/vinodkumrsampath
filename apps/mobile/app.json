{
  "expo": {
    "name": "Verified",
    "slug": "verified",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Verified needs camera access for selfie verification." }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Used to show profiles near you." }],
      "expo-notifications"
    ],
    "scheme": "verified",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.verified.dating"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.verified.dating"
    }
  }
}
