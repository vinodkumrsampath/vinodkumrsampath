# ============================================================
# Verified Dating App — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (run: docker compose -f infrastructure/docker-compose.yml up -d)
DATABASE_URL=postgresql://verified:verified_dev@localhost:5432/verified
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email OTP — free via Gmail SMTP (enable App Password in Google Account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@verified.app

# Cloudflare R2 (free: 10GB, 1M reads/month)
# https://dash.cloudflare.com/ → R2 → Create bucket
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=verified-photos
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Hugging Face (free tier text moderation — optional, keyword filter used as fallback)
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Stripe (optional — only needed for ad-free premium subscription)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Field encryption (AES-256 for any future sensitive fields)
FIELD_ENCRYPTION_KEY=
